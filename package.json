{
  "name": "@peeko-labs/mcp",
  "version": "0.0.4",
  "description": "The case you send your processor. An MCP that builds a masked fraud case from the systems you already have.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "peeko-mcp": "build/index.cjs"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=build/index.cjs && chmod +x build/index.cjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "node --test build/*.test.cjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@peeko/protocol": "file:../chase/packages/protocol",
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "yaml": "^2.8.0",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peeko-labs/peeko.git"
  },
  "homepage": "https://peeko.sh",
  "publishConfig": {
    "access": "public"
  }
}
